PORT=4000
JWT_SECRET=change-this-to-a-long-random-string-in-production
CLIENT_ORIGIN=http://localhost:5173
# Local MongoDB (install from https://www.mongodb.com/try/download/community or use Docker Desktop)
MONGODB_URI=mongodb://127.0.0.1:27017/restaurant
# Atlas example (replace user, password, cluster):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/restaurant?retryWrites=true&w=majority
